model Payment {
    id                 String        @id @default(uuid(7))
    appointmentId      String        @unique
    appointment        Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    amount             Float
    transactionId      String
    status             PaymentStatus @default(UNPAID)
    paymentGatewayData Json?
    createdAt          DateTime      @default(now())
    updatedAt          DateTime      @updatedAt

    @@index([appointmentId], name: "idx_payment_appointmentId")
    @@index([transactionId], name: "idx_payment_transacionId")
    @@map("payments")
}
