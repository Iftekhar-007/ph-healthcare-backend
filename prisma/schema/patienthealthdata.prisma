model PatientHealthData {
    id                  String         @id @default(uuid(7))
    patientId           String         @unique
    patient             Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    dateOfBirth         DateTime
    gender              Gender
    bloodGroup          BloodGroup
    hasAllergy          Boolean        @default(false)
    hasDiabetic         Boolean        @default(false)
    height              String
    weight              String
    smokingStatus       Boolean        @default(false)
    dietaryPreference   String?
    pregnancyStatus     Boolean        @default(false)
    mentalHealthHistory String?
    immunizationSTatus  String?
    hasPastSurgeries    Boolean        @default(false)
    recentAnxiety       Boolean        @default(false)
    recentDepression    Boolean        @default(false)
    maritalStatus       MaritalStatus? @default(UNMARRIED)
    isDeleted           Boolean        @default(false)
    deletedAt           DateTime
    createdAt           DateTime       @default(now())
    updatedAt           DateTime       @updatedAt

    @@index([patientId], name: "idx_patient_health_data_patientId")
    @@map("patienthealthdata")
}
